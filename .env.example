NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deadline notifications. Generate the pair once with:
#   npx web-push generate-vapid-keys
# The public half is handed to browsers by /api/push/subscribe; the private half
# never leaves the server. VAPID_SUBJECT is a mailto: address the push services can
# use to reach whoever runs the deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
